{
  "name": "dsh-wetflow",
  "version": "0.1.0-alpha.1",
  "description": "A research workspace for projects, evidence and researcher-approved workflows.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh-plugin",
    "wetlab",
    "research",
    "openmm",
    "workflow"
  ],
  "os": [
    "linux"
  ],
  "files": [
    "*.js",
    "cordis.patch.yml",
    "md",
    "scripts",
    "tests",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package-lock.json",
    "wetflow/dist/node",
    "wetflow/src",
    "wetflow/scripts/copy-modeling-worker.mjs",
    "wetflow/examples",
    "wetflow/package.json",
    "wetflow/package-lock.json",
    "wetflow/tsdown.config.ts",
    "wetflow/tsconfig.json",
    "wetflow/LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/build.mjs --if-needed",
    "build": "node scripts/build.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/test.mjs",
    "test:network": "WETFLOW_TEST_PUBLIC_NETWORK=1 node tests/process-gate.mjs",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell-env": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.1-rc.5"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@napi-rs/canvas": "1.0.11",
    "cordis": "4.0.0-rc.8",
    "fastify": "5.11.3",
    "pdfjs-dist": "6.4.299",
    "unpdf": "1.9.1",
    "zod": "3.25.76"
  }
}
